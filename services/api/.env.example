# Copy to .env and fill in. Do not commit .env.

SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Seeded procurement admin (Lucía Fernández). Used only when the auth DB is empty.
SEED_ADMIN_EMAIL=lucia.fernandez@brasaland.com
SEED_ADMIN_PASSWORD=replace-with-a-local-demo-password

# Sprint 3 — password reset (Resend). Never commit the API key.
RESEND_API_KEY=replace-with-resend-api-key
RESET_TOKEN_EXPIRE_MINUTES=30
PUBLIC_APP_URL=http://localhost:3101
# Optional. Resend onboarding default only delivers to your Resend account email.
# RESEND_FROM_EMAIL=Brasaland <beth.t@example.com>
