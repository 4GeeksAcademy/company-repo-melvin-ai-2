# Copy to `.env` at the repo root. Never commit `.env`.

# Browser (host) → published API port
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_INVENTORY_API_URL=http://localhost:8000

# Container-to-container on the Compose network (not localhost).
# Used by server-side getBrasalandApiBase, UI start.sh health wait, and /backend-api rewrites.
INTERNAL_API_URL=http://backend:8000

# FastAPI (same names as services/api/.env.example)
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
SEED_ADMIN_EMAIL=lucia.fernandez@brasaland.com
SEED_ADMIN_PASSWORD=replace-with-a-local-demo-password
RESEND_API_KEY=replace-with-resend-api-key
RESET_TOKEN_EXPIRE_MINUTES=30
PUBLIC_APP_URL=http://localhost:3001
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
